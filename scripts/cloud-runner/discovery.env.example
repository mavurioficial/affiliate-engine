# EXAMPLE ONLY. Do not commit real values or copy secrets to GitHub.
# Install private env at /etc/mavuri/discovery.env, mode 0600, owner root.
# systemd EnvironmentFile values must be syntactically valid for EnvironmentFile,
# not arbitrarily shell-evaluated. Never echo secrets during debugging.
MAVURI_DISCOVERY_SCRIPT=/opt/mavuri/affiliate-engine/private/browser-discovery-v85.cloud.mjs
MAVURI_CHROME_PROFILE=/var/lib/mavuri/chrome-profile
MAVURI_CHROME_PORT=9222
CHROME_PATH=/usr/bin/chromium-browser
MAVURI_TELEGRAM_SESSION_FILE=/var/lib/mavuri/telegram-user.session
MAVURI_DISCOVERY_STATE=/var/lib/mavuri/discovery-state.json
MAVURI_DISCOVERY_OUTPUT=/var/lib/mavuri/discovery-latest.json
MAVURI_SHOPEE_VOUCHER_STATE_FILE=/var/lib/mavuri/shopee-voucher-state.json
MAVURI_ML_TARGET_OFFERS=8
MAVURI_SHOPEE_TARGET_OFFERS=8
MAVURI_MAGALU_TARGET_OFFERS=5
MAVURI_AUTO_INGEST=false
# NEVER activate until V85 cloud fully reauthenticated/tested and Windows fenced.
MAVURI_CLOUD_LIVE_ENABLED=NO
MAVURI_CLOUD_WINDOWS_STOPPED=NOT_CONFIRMED
# All credentials below must be inserted manually on the VM, NOT here in git.
MAVURI_TELEGRAM_API_ID=
MAVURI_TELEGRAM_API_HASH=
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
MAVURI_SUPABASE_URL=
MAVURI_SUPABASE_PUBLISHABLE_KEY=
MAVURI_APP_URL=https://mavurioficial.github.io/affiliate-engine/
